{
  "name": "@attocash/n8n-nodes-atto",
  "version": "0.4.3",
  "description": "Atto cryptocurrency wallet, transaction, account, and trigger nodes for n8n, powered by Atto Commons",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "n8n-nodes",
    "n8n-community-node",
    "atto",
    "atto-cash",
    "attocash",
    "atto-commons",
    "cryptocurrency",
    "crypto",
    "blockchain",
    "wallet",
    "payments",
    "automation"
  ],
  "author": {
    "name": "Atto",
    "email": "contact@atto.cash"
  },
  "homepage": "https://github.com/attocash/integrations-n8n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/attocash/integrations-n8n.git"
  },
  "bugs": {
    "url": "https://github.com/attocash/integrations-n8n/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/nodes/Atto/Atto.node.js",
  "files": [
    "dist",
    "examples",
    "THIRD_PARTY_NOTICES.md",
    "scripts/check-runtime.cjs"
  ],
  "scripts": {
    "build": "node scripts/check-runtime.cjs && n8n-node build && node scripts/prepare-dist.mjs",
    "build:watch": "node scripts/check-runtime.cjs && tsc --watch",
    "clean": "rimraf dist",
    "dev": "node scripts/check-runtime.cjs && n8n-node dev",
    "install:n8n": "sh scripts/install-into-n8n.sh",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --test scripts/check-runtime.test.cjs && npm run build && node scripts/run-tests.mjs",
    "test:integration": "npm run build && ATTO_TEST_INTEGRATION=1 node --test test/integration.test.mjs",
    "validate:local": "node scripts/validate-local.mjs",
    "validate:release-tag": "node scripts/validate-release-tag.mjs",
    "check:runtime": "node scripts/check-runtime.cjs",
    "test:runtime": "node --test scripts/check-runtime.test.cjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "devDependencies": {
    "@attocash/commons-core": "7.0.2",
    "@attocash/commons-test": "7.0.2",
    "@n8n/node-cli": "0.41.2",
    "@types/node": "^22.15.21",
    "esbuild": "0.27.1",
    "eslint": "9.29.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AttoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Atto/Atto.node.js",
      "dist/nodes/AttoTrigger/AttoTrigger.node.js"
    ]
  }
}
